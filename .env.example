# --- Site ---
# Canonieke host. Moet overeenkomen met de primaire host in Netlify.
NEXT_PUBLIC_SITE_URL=https://pandplicht.nl

# --- Opslag (leads, contactberichten, uitslagen) ---
# In productie op Netlify wordt automatisch Netlify Blobs gebruikt: duurzame
# opslag die tegen serverless functions bestand is. Daar is geen configuratie
# voor nodig, Netlify zet de benodigde variabelen zelf. Lokaal (zonder
# Netlify-context) valt de app terug op een bestandsadapter in .data/.
#
# LET OP: een gewone bestandsadapter is in productie niet bruikbaar. Serverless
# functies hebben een tijdelijke schijf, dus een write slaagt wel maar de data
# is daarna weg. Vandaar Blobs.

# --- E-mailnotificatie bij nieuwe leads (Resend) ---
# Zonder deze variabelen wordt er geen mail verstuurd en worden leads alleen
# opgeslagen. Een mislukte notificatie blokkeert het opslaan nooit.
# Gratis sleutel via https://resend.com
RESEND_API_KEY=
# Ontvanger van de notificaties, bijv. jij@pandplicht.nl
LEAD_NOTIFY_TO=
# Afzender op een in Resend geverifieerd domein. Zonder geverifieerd domein kun
# je tijdelijk onboarding@resend.dev gebruiken (alleen naar je eigen adres).
LEAD_NOTIFY_FROM=

# --- Analytics (privacyvriendelijk, cookieloos) ---
# "umami" | "plausible" | leeg (uit).
# Let op: NEXT_PUBLIC_-variabelen worden tijdens de BUILD in de pagina gezet.
# Na het wijzigen hiervan is dus een nieuwe deploy nodig.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Bij umami: het website-id uit je Umami-dashboard.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Alleen nodig bij self-hosted Umami.
NEXT_PUBLIC_UMAMI_SRC=
# Bij plausible: het domein zoals in Plausible geregistreerd.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- Feature flags ---
# Advertenties staan bij lancering uit. Zet pas aan met werkende labeling en metingen.
ADS_ENABLED=false
# EP-Online-koppeling (energielabels). Zet op true en vul EPONLINE_API_KEY om
# in de PandCheck automatisch het label op te halen. Zonder sleutel of vlag
# blijven de handmatige velden de terugval (er wordt nooit een label verzonnen).
ENABLE_EP_ONLINE_INTEGRATION=false
# Gratis API-sleutel aanvragen bij RVO: https://www.ep-online.nl (API-toegang).
EPONLINE_API_KEY=
# Capaciteitskaart elektriciteitsnet (Netbeheer Nederland). Toont de
# gebiedsindicatie voor afname en teruglevering bij de netbeheerdersvraag.
# Keyless. Staat achter een vlag omdat het een gebied beschrijft en niet
# één specifieke aansluiting.
ENABLE_LIVE_GRID_DATA=false

# --- Privacy ---
# Bewaartermijn van assessments in dagen; daarna verwijderen of anonimiseren.
ASSESSMENT_RETENTION_DAYS=30
